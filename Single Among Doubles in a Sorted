Problem : Single Among Doubles in a Sorted
=========================================
Given a sorted array arr[]. Find the element that appears only once in the array. All other elements appear exactly twice. 

Examples:

Input: arr[] = [1, 1, 2, 2, 3, 3, 4, 50, 50, 65, 65]
Output: 4
Explanation: 4 is the only element that appears exactly once.

Input: arr[] = [5]
Output: 5

Input: arr[] = [1, 2, 2, 3, 3]
Output: 1
=========================================
Solution
=========================================
class Solution {
    public int single(int[] arr) {

        Dictionary<int, int> dict = new Dictionary<int, int>();

        // Count frequency of each element
        foreach (int num in arr)
        {
            if (dict.ContainsKey(num))
            {
                dict[num]++;
            }
            else
            {
                dict[num] = 1;
            }
        }

        // Find element with frequency 1
        foreach (KeyValuePair<int, int> item in dict)
        {
            if (item.Value == 1)
            {
                return item.Key;
            }
        }

        return -1;
    }
}
